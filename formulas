const GRADE_POINTS = {
  'A': 4.0, 'A-': 3.7,
  'B+': 3.3, 'B': 3.0, 'B-': 2.7,
  'C+': 2.3, 'C': 2.0, 'C-': 1.7,
  'D+': 1.3, 'D': 1.0, 'F': 0.0
};

export function calculateGPA(courses = []) {
  // Exclude ungraded or "In Progress" courses
  const gradedCourses = courses.filter(
    (c) => c.grade && GRADE_POINTS[c.grade] !== undefined && Number(c.credits) > 0
  );

  if (gradedCourses.length === 0) return 0.0;

  const { totalPoints, totalCredits } = gradedCourses.reduce(
    (acc, course) => {
      const credits = Number(course.credits);
      acc.totalPoints += GRADE_POINTS[course.grade] * credits;
      acc.totalCredits += credits;
      return acc;
    },
    { totalPoints: 0, totalCredits: 0 }
  );

  return totalCredits > 0 ? Number((totalPoints / totalCredits).toFixed(2)) : 0.0;
}
